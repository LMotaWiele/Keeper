# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-opus-4-5                        # or claude-sonnet-4-5 for faster/cheaper

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here  # from @BotFather
TELEGRAM_ALLOWED_USER_IDS=123456789              # comma-separated; your Telegram user ID(s)

# ── Web Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here          # https://tavily.com — free tier is fine

# ── Memory ────────────────────────────────────────────────────────────────────
# Short-term  → in-process (no config needed)
# Mid-term    → SQLite (auto-created)
MIDTERM_DB_PATH=./data/midterm.db

# Long-term   → ChromaDB vector store (auto-created)
CHROMA_DB_PATH=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small           # OpenAI embeddings (cheap & good)
OPENAI_API_KEY=your_openai_api_key_here          # only used for embeddings

# ── Paths ─────────────────────────────────────────────────────────────────────
SOUL_FILE_PATH=./SOUL.md
DATA_DIR=./data
