# ── LLM (OpenRouter) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
# MODEL_HIGH=google/gemini-3.8-flash
# MODEL_MID=google/gemini-3.8-flash
# MODEL_LOW=z-ai/glm-5.3-flash
# MODEL_HIGH_FALLBACK=google/gemini-3.7-flash
# MODEL_MID_FALLBACK=google/gemini-3.7-flash
# MODEL_LOW_FALLBACK=~deepseek/deepseek-flash-latest
# JEV_MODEL=~typesafe/jev-latest
# DAILY_BUDGET_EUR=10.0
# USD_TO_EUR=0.92

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789              # comma-separated user IDs

# ── Web search (SearXNG) ──────────────────────────────────────────────────
# SEARXNG_QUERY_URL=http://localhost:8081/search?q=<query>
# SEARCH_MAX_RESULTS=6
# SEARCH_MAX_FETCH=5
# SEARCH_FETCH_TIMEOUT_SEC=8

# ── Embeddings (local fastembed) ──────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=./data/fastembed

# ── Paths ─────────────────────────────────────────────────────────────────
DATA_DIR=./data
SOUL_FILE_PATH=./SOUL.md                         # local; copy from SOUL.md.example
MIDTERM_DB_PATH=./data/episodic.db               # episodic SQLite
CHROMA_DB_PATH=./data/chroma                     # semantic vectors

# ── Loops (optional) ──────────────────────────────────────────────────────
# CONSOLIDATION_INTERVAL_MIN=30
# SELF_MODEL_INTERVAL_MIN=60
# AUTONOMOUS_INTERVAL_MIN=5
# GROUNDING_INTERVAL_SEC=30
# SESSION_TIMEOUT_MIN=15
# WORKING_MEMORY_CAPACITY=20
# DIALOGUE_WINDOW=12
# PIN_CAPACITY=8
# PIN_MAX_AGE_DAYS=14

# ── Opinions (optional) ───────────────────────────────────────────────────
# OPINION_REVIEW_INTERVAL_MIN=180
# INDEPENDENCE_THRESHOLD=0.3
# MAX_TRACKED_OPINIONS=100

# ── Diagnostics (optional) ────────────────────────────────────────────────
# DIAG_MODE=0                                      # 1 = per-message graph dump + prompt files

# ── Evidence-based salience / forgetting (optional) ───────────────────────
# FORGET_MIN_AGE_DAYS=7
# FORGET_THRESHOLD=0.25
# FORGET_MAX_PER_PASS=50
# FORGET_DRY_RUN=0                                 # live deletion; keep MAX_PER_PASS=50 for week one

# ── Prompt state injection (optional; comma-separated; empty omits block) ─
# STATE_FIELDS_INJECTED=                           # 72h std < 0.05 on all affect fields
# DRIVES_INJECTED=understand,connect,create,resolve,express

# ── User-life tracker (optional) ──────────────────────────────────────────
# COMMITMENTS_INJECTED_MAX=5
# COMMITMENT_GRACE_HOURS=24
# OVERDUE_SURFACE_COOLDOWN_H=24
# USER_TIMEZONE=Europe/Amsterdam

# ── action_bias (optional) ────────────────────────────────────────────────
# ACTION_BIAS_ENABLED=1
# ACTION_BIAS_STREAK_LEN=3
# STANDING_CONSTRAINTS_MAX=3
# ACTION_BIAS_MIN_REPLY_TOKENS=20
